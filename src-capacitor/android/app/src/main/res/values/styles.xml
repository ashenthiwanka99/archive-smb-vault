<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — Night Archive -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#E8A33D</item>
        <item name="colorPrimaryDark">#0B0D13</item>
        <item name="colorAccent">#E8A33D</item>
        <item name="android:windowBackground">#0B0D13</item>
        <item name="android:navigationBarColor">#0B0D13</item>
        <item name="android:statusBarColor">#0B0D13</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">#0B0D13</item>
        <item name="android:statusBarColor">#0B0D13</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
